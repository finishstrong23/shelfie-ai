{
  "expo": {
    "name": "Shelfie AI",
    "slug": "shelfie-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "shelfie",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#10B981"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.shelfie.ai",
      "infoPlist": {
        "NSCameraUsageDescription": "Shelfie AI needs camera access to scan your food items",
        "NSPhotoLibraryUsageDescription": "Shelfie AI needs photo library access to import food photos"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#10B981"
      },
      "package": "com.shelfie.ai",
      "permissions": ["CAMERA"]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Shelfie AI needs camera access to scan your food items."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Shelfie AI needs photo library access to import food photos."
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#10B981"
        }
      ]
    ]
  }
}
